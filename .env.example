NEXT_PUBLIC_API_URL=https://localhost:7088/api

# ── Política de contenido (CSP) ───────────────────────────────────────────────
# Modo: "reporte" solo avisa en la consola del navegador; "bloqueo" impide la
# carga. Se publica en reporte, se revisa y después se pasa a bloqueo.
# Los dominios de RPP/SICE no se listan aquí: viven en la pantalla de Procesos
# y la política ya admite cualquier origen HTTPS en imágenes, consultas y marcos.
CSP_MODO=reporte
# Opcional: dirección que recibe los reportes de violaciones de la política.
CSP_REPORT_URI=
